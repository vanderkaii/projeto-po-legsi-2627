@startuml
skinparam classAttributeIconSize 0

abstract class Habitante {
  - id: int
  - nomeCompleto: String
  - emailInstitucional: String
  - profissao: String
  - numeroMissoesRealizadas: int
  - numeroDescobertasRegistadas: int
  - contadorId: int {static}
}

class Cientista {
  - areaCientifica: String
}

class Engenheiro {
  - especialidadeTecnica: String
}

class Explorador

class Administrador

class GestorColonia {
  - numMissoesSuperv: int
}

class Colonia {
  - id: int
  - nome: String
  - planeta: String
  - /numeroMissoesConcluidas: int
}

class Missao {
  - idM: int
  - designacao: String
  - objetivo: String
  - estado: EstadoMissao
}

class Descoberta {
  - id: int
  - tipo: String
  - data: Date
  - descricao: String
}

enum EstadoMissao {
  Planeada
  EmCurso
  Concluida
}

Habitante <|-- Cientista
Habitante <|-- Engenheiro
Habitante <|-- Explorador
Habitante <|-- Administrador
Habitante <|-- GestorColonia

Colonia "1" -- "0..*" Habitante : acolhe
Colonia "1" -- "0..*" Missao : organiza
Habitante "0..*" -- "0..*" Missao : participa
GestorColonia "1" -- "0..*" Missao : supervisiona
Missao "1" -- "0..*" Descoberta : origina
Habitante "1" -- "0..*" Descoberta : responsavel

Administrador ..> Colonia : gere
Administrador ..> Missao : gere

note right of EstadoMissao
  Tipo enumerado usado no atributo
  Missao.estado; nao e uma entidade
  nem uma associacao de dominio.
end note

note bottom of Colonia
  A associacao Colonia-Missao e inferida
  da organizacao das missoes pela colonia.
end note
@enduml
